# Alexios V2: ligação com a aplicação de produção na Vercel.
ALEXIOS_BRIDGE_URL=https://alexios-web.vercel.app

# O mesmo ALEXIOS_AGENT_TOKEN configurado no projeto alexios-web na Vercel.
ALEXIOS_AGENT_TOKEN=substitua-por-um-segredo-com-24-ou-mais-caracteres

# Crie UMA VEZ: printf 'alx_%s\n' "$(openssl rand -hex 24)"
# Identificador estável: é a credencial informada no botão AUTORIZAR ACESSO do painel.
# Não gere outro identificador a cada execução.
ALEXIOS_INSTANCE_ID=

# APENAS para o modo interativo LEGADO: python main.py.
# NÃO é necessário ao continuous.py V2.
OPENROUTER_API_KEY=
